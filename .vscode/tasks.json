{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check Bash syntax",
      "type": "shell",
      "command": "for file in init.sh functions/*.sh; do bash -n \"$file\" || exit 1; done",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "bash",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+): line ([0-9]+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "reveal": "silent"
      }
    }
  ]
}
